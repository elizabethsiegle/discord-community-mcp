DISCORD_BOT_TOKEN=replace-with-your-bot-token
# Keep write operations disabled until you explicitly opt in.
DISCORD_ENABLE_WRITE=false
# Enable separately to assign existing server roles to members.
DISCORD_ENABLE_ROLE_MANAGEMENT=false
# Optional. Defaults to ./data/discord-analytics.sqlite beside the built server.
# DISCORD_ANALYTICS_DB=/absolute/path/to/discord-analytics.sqlite
